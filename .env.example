# Server-side only. Never ship these to the extension.
OPENAI_API_KEY=
# Matches docker-compose.yml (local only). If 5432 is taken, start the db with
# FACTCHECK_DB_PORT=55432 and use that port here too.
DATABASE_URL=postgres://factcheck:factcheck@127.0.0.1:5432/factcheck

# Optional tuning (defaults shown)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# DECISIONS_MODEL=gpt-6-luna
# FACT_TOP_K=5
# FACT_MIN_SIMILARITY=0.35
# VERDICT_MIN_RELEVANCE=0.5
# VERDICT_MIN_CONFIDENCE=0.6
# OPENAI_TIMEOUT_MS=2500
# Conversation capture only; POST /api/fact-check/live never caches verdicts.
# FACT_CHECK_CACHE_TTL_MS=600000

# Conversation capture (docs/specs/conversation-capture.md), defaults shown
# CLAIM_EXTRACTION_MODEL=gpt-6-luna
# CLAIM_EXTRACTION_EFFORT=low        # none|minimal|low|medium|high
# CLAIM_EXTRACTION_TIMEOUT_MS=10000
# CLAIM_CONTEXT_UTTERANCES=6
# CLAIM_CHECK_CONCURRENCY=4
# TRANSCRIPTION_MODEL=gpt-live-transcribe
# TRANSCRIPTION_TOKEN_TTL_SECONDS=600
