# Server-side only. Never ship these to the extension.
OPENAI_API_KEY=
# Matches docker-compose.yml (local only).
DATABASE_URL=postgres://factcheck:factcheck@127.0.0.1:5432/factcheck

# Optional tuning (defaults shown)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# DECISIONS_MODEL=gpt-6-luna
# FACT_TOP_K=5
# FACT_MIN_SIMILARITY=0.35
# VERDICT_MIN_RELEVANCE=0.5
# VERDICT_MIN_CONFIDENCE=0.6
# OPENAI_TIMEOUT_MS=2500
# FACT_CHECK_CACHE_TTL_MS=600000
